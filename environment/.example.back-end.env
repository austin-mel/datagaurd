# Copy this file to environment/.back-end.env and restart the backend after edits.
# Process environment variables (including hosting settings) override this file.
# See docs/CONFIGURATION.md for the full configuration reference.

# -----------------------------------------------------------------------------
# REQUIRED VARIABLES: Deployment and workspace settings
# Every backend setting has a built-in default, so this file is optional.
# Omit or comment out an optional variable to use its default; do not leave it blank.
# Review these when hosting the app or changing where its data is stored.
# -----------------------------------------------------------------------------
DATAGUARD_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DATAGUARD_STORAGE_DIR=storage
DATAGUARD_ACTOR=local_operator

# Default rules file.
# DATAGUARD_RULES_PATH=config/generic.yaml

# Optional fixed ISO date for reproducible checks (YYYY-MM-DD).
# DATAGUARD_REFERENCE_DATE=2026-10-07

# -----------------------------------------------------------------------------
# OPTIONAL ADJUSTERS: Upload and processing limits
# All values must be positive integers. Values below are the built-in defaults.
# -----------------------------------------------------------------------------
DATAGUARD_MAX_UPLOAD_BYTES=104857600
DATAGUARD_MAX_ROWS=500000
DATAGUARD_MAX_COLUMNS=1000
DATAGUARD_MAX_CELLS=2000000
DATAGUARD_MAX_DECODED_BYTES=209715200

# -----------------------------------------------------------------------------
# OPTIONAL ADJUSTERS: Statistical thresholds
# Values below are the built-in defaults, but a ruleset can override these thresholds.
# -----------------------------------------------------------------------------
DATAGUARD_STATISTICAL_MIN_SAMPLES=20
DATAGUARD_IQR_MULTIPLIER=1.5
DATAGUARD_MISSINGNESS_INCREASE_PERCENTAGE_POINTS=5
DATAGUARD_ROW_COUNT_CHANGE_PERCENTAGE=20
DATAGUARD_CATEGORY_SHARE_CHANGE_PERCENTAGE_POINTS=10
DATAGUARD_FINDING_SAMPLE_SIZE=20
DATAGUARD_TOP_CATEGORY_COUNT=5

