# Copy this file to environment/.front-end.env and restart Vite after edits; rebuild/redeploy for production changes..
# See docs/CONFIGURATION.md for the full configuration reference.
# All settings have defaults; none are required for local development.

# -----------------------------------------------------------------------------
# REQUIRED VARIABLES: Deployment and workspace settings
# Every frontend setting has a built-in default, so this file is optional.
# Omit or comment out an optional variable to use its default; do not leave it blank.
# # API URL when the frontend and backend are hosted separately.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# OPTIONAL ADJUSTERS: Change data source and add local development proxy target
# Values below are the built-in defaults.
# -----------------------------------------------------------------------------
# Use api to connect to the backend, or seeded to use built-in sample data.
VITE_DATA_SOURCE=api
# Local development proxy target.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000
